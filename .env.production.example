# ResolveAI production environment
# Copy to .env.production on the server and fill in secrets.
# Never commit the real .env.production file.

NODE_ENV=production

# --- Compose / Postgres ---
POSTGRES_DB=resolveai
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://resolveai:change_me_strong_password@postgres:5432/resolveai?schema=public

# --- Redis / queues ---
REDIS_URL=redis://redis:6379
QUEUE_PREFIX=resolveai

# --- Public URLs (must match DNS + CORS) ---
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
CORS_ORIGIN=https://app.yourdomain.com
AI_SERVICE_URL=http://ai-service:8000
TRUST_PROXY=true

# --- Auth secrets (openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
INTEGRATION_SECRET_ENCRYPTION_KEY=change_this_integration_key_min_16

# --- Email (Resend preferred — free tier) ---
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
ORGANIZATION_INVITE_TOKEN_TTL_HOURS=72

RESEND_API_KEY=
RESEND_FROM=ResolveAI <noreply@yourdomain.com>
EMAIL_FROM=ResolveAI <noreply@yourdomain.com>

# Optional SMTP fallback if RESEND_API_KEY is empty:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=

# --- AI usage / free product ---
AI_USAGE_TRACKING_ENABLED=true
AGENTIC_CHAT_ENABLED=true
AGENT_TOOL_APPROVAL_ENABLED=true
INTEGRATIONS_ENABLED=true

# --- Storage ---
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=resolveai-knowledge

# --- Metrics / security ---
ENABLE_METRICS=true
METRICS_TOKEN=
AGENT_RUN_DEBUG_PAYLOAD_ENABLED=false
SECURITY_STARTUP_CHECKS_ENABLED=true
REQUIRE_HTTPS_IN_PRODUCTION=true
BLOCK_PRIVATE_NETWORK_INTEGRATIONS=true

# --- AI service (also read by docker-compose.prod.yml) ---
ENVIRONMENT=production
SERVICE_NAME=resolveai-ai
API_VERSION=v1
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GOOGLE_API_KEY=
GEMINI_MODEL=
REQUEST_TIMEOUT_SECONDS=120

# --- Host ports (optional) ---
API_PORT=5000
